[primary]
primary ansible_host=${primary_public} node_private_ip=${primary_private} node_role=primary

[secondary]
secondary ansible_host=${secondary_public} node_private_ip=${secondary_private} node_role=secondary

[court_nodes:children]
primary
secondary

[court_nodes:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=${ssh_private_key}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30'
primary_private_ip=${primary_private}
secondary_private_ip=${secondary_private}
