APP_ENV=development
DATABASE_URL=postgresql+psycopg://court:court-local-password@localhost:5432/court
REDIS_URL=redis://:local-redis-password@localhost:6379/0
DB_PASSWORD=court-local-password
REDIS_PASSWORD=local-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=court-service
JWT_MINUTES=30
APP_BASE_URL=http://localhost:8080
EMAIL_BACKEND=console
PAYMENT_PROVIDER=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
BOOTSTRAP_ADMIN_EMAIL=admin@courtly.example
BOOTSTRAP_ADMIN_PASSWORD=LocalOnly-ChangeMe-123!
DEBUG_EMAIL_TOKENS=true
ALLOW_LEGACY_HEADERS=true
ALLOW_DIRECT_CONFIRM=true
STAFF_KEY=local-staff-key
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=LocalOnly-Grafana-ChangeMe-123!

# Notification wakeups. Leave KAFKA_BOOTSTRAP_SERVERS empty to disable Kafka;
# the worker then polls every WORKER_SWEEP_SECONDS (default 2 without Kafka, 60 with it).
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_NOTIFICATION_TOPIC=court.notifications.ready
KAFKA_CONSUMER_GROUP=court-notification-workers
